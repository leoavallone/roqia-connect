<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#0b1712">
    <title>Conectar WhatsApp · RoqIA</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    <script src="/assets/js/app.js" defer></script>
  </head>
  <body
    data-view="<%= authenticated ? 'dashboard' : 'login' %>"
    data-client-id="<%= clientId %>"
  >
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <main class="shell">
      <header class="brandbar">
        <a class="brand" href="/" aria-label="RoqIA">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="brand-name">Roq<span>IA</span></span>
        </a>
        <% if (authenticated) { %>
          <button class="quiet-button" id="logoutButton" type="button">Sair</button>
        <% } else { %>
          <span class="secure-label">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3m-9 0h8a2 2 0 0 1 2 2v7H6v-7a2 2 0 0 1 2-2Z"/></svg>
            Acesso seguro
          </span>
        <% } %>
      </header>

      <% if (!authenticated) { %>
        <section class="auth-layout" aria-labelledby="pageTitle">
          <div class="intro-copy">
            <div class="eyebrow"><span></span> WhatsApp Manager</div>
            <h1 id="pageTitle">Seu WhatsApp,<br><em>sempre conectado.</em></h1>
            <p>Verifique a conexão e reconecte sua conta com segurança, em poucos instantes.</p>
            <div class="trust-list" aria-label="Benefícios">
              <div><span class="check">✓</span> Conexão protegida</div>
              <div><span class="check">✓</span> Atualização em tempo real</div>
            </div>
          </div>

          <div class="card login-card">
            <div class="card-icon whatsapp-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.9Z"/><path d="M8.1 7.5c.2-.4.4-.4.7-.4h.5l.8 1.9c.1.3 0 .5-.2.7l-.6.7c-.2.2-.1.4 0 .6.6 1 1.4 1.8 2.5 2.4.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l1.9.9c.3.1.4.3.4.5 0 .4-.2 1.3-.8 1.8-.5.5-1.3.8-2.2.6-1.1-.2-2.7-.8-4.4-2.3-1.4-1.3-2.4-2.9-2.7-4-.3-.8.1-1.6.4-2.1Z"/></svg>
            </div>
            <div class="card-heading">
              <span>Conectar WhatsApp</span>
              <h2><%= clientName %></h2>
              <p>Digite seu PIN de acesso para continuar.</p>
            </div>

            <form id="loginForm" novalidate>
              <label for="pin">Senha / PIN</label>
              <div class="password-field">
                <svg class="field-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3m-9 0h8a2 2 0 0 1 2 2v7H6v-7a2 2 0 0 1 2-2Z"/></svg>
                <input id="pin" name="pin" type="password" inputmode="numeric" autocomplete="current-password" minlength="4" maxlength="128" placeholder="Digite seu PIN" required autofocus>
                <button class="reveal-button" id="revealPin" type="button" aria-label="Mostrar PIN">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"/><circle cx="12" cy="12" r="2.3"/></svg>
                </button>
              </div>
              <p class="form-error" id="loginError" role="alert" aria-live="polite"></p>
              <button class="primary-button" id="loginButton" type="submit">
                <span>Acessar</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </form>
            <div class="privacy-note">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.8 8.1 7 10 4.2-1.9 7-5.5 7-10V6l-7-3Z"/><path d="m9.5 12 1.6 1.6 3.5-3.7"/></svg>
              Seus dados de acesso são protegidos e nunca compartilhados.
            </div>
          </div>
        </section>
      <% } else { %>
        <section class="dashboard" aria-labelledby="pageTitle">
          <div class="dashboard-heading">
            <div>
              <div class="eyebrow"><span></span> WhatsApp Manager</div>
              <h1 id="pageTitle">Conectar WhatsApp</h1>
              <p>Cliente: <strong><%= clientName %></strong></p>
            </div>
            <button class="secondary-button" id="refreshButton" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6v5h-5M4 18v-5h5"/><path d="M6.1 9A7 7 0 0 1 18 6l2 2M17.9 15A7 7 0 0 1 6 18l-2-2"/></svg>
              Verificar conexão
            </button>
          </div>

          <div class="dashboard-grid">
            <section class="card status-card" aria-labelledby="statusHeading">
              <div class="status-topline">
                <div class="card-icon whatsapp-icon small" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.9Z"/><path d="M8.1 7.5c.2-.4.4-.4.7-.4h.5l.8 1.9c.1.3 0 .5-.2.7l-.6.7c-.2.2-.1.4 0 .6.6 1 1.4 1.8 2.5 2.4.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l1.9.9c.3.1.4.3.4.5 0 .4-.2 1.3-.8 1.8-.5.5-1.3.8-2.2.6-1.1-.2-2.7-.8-4.4-2.3-1.4-1.3-2.4-2.9-2.7-4-.3-.8.1-1.6.4-2.1Z"/></svg>
                </div>
                <div>
                  <span class="overline">Canal de atendimento</span>
                  <h2 id="statusHeading">WhatsApp</h2>
                </div>
              </div>

              <div class="status-panel is-loading" id="statusPanel">
                <div class="status-orb"><span></span></div>
                <div>
                  <span class="status-label">Status da conexão</span>
                  <strong id="statusText">Verificando...</strong>
                  <p id="statusDescription">Aguarde enquanto consultamos sua sessão.</p>
                </div>
              </div>

              <button class="primary-button" id="generateQrButton" type="button" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM15 14h2v2h-2zM19 14h1v3h-3v3h-3v-3h2"/></svg>
                <span>Gerar QR Code</span>
              </button>
              <p class="last-check" id="lastCheck"></p>
            </section>

            <section class="card qr-card" id="qrCard" aria-labelledby="qrHeading" hidden>
              <div class="qr-heading">
                <div>
                  <span class="overline">Conecte seu aparelho</span>
                  <h2 id="qrHeading">Escaneie o QR Code</h2>
                </div>
                <span class="live-badge"><span></span> Ao vivo</span>
              </div>

              <div class="qr-loading" id="qrLoading">
                <span class="spinner"></span>
                <strong>Gerando QR Code...</strong>
                <p>Isso pode levar alguns segundos.</p>
              </div>
              <div class="qr-content" id="qrContent" hidden>
                <div class="qr-frame"><img id="qrImage" alt="QR Code para conectar o WhatsApp"></div>
                <ol class="instructions">
                  <li><span>1</span><div>Abra o <strong>WhatsApp</strong> no celular</div></li>
                  <li><span>2</span><div>Acesse <strong>Configurações → Aparelhos conectados</strong></div></li>
                  <li><span>3</span><div>Toque em <strong>Conectar um aparelho</strong> e escaneie</div></li>
                </ol>
                <button class="text-button" id="updateQrButton" type="button">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6v5h-5M4 18v-5h5"/><path d="M6.1 9A7 7 0 0 1 18 6l2 2M17.9 15A7 7 0 0 1 6 18l-2-2"/></svg>
                  Atualizar QR Code
                </button>
              </div>
              <p class="form-error centered" id="qrError" role="alert" aria-live="polite"></p>
            </section>
          </div>
        </section>
      <% } %>

      <footer><span>© <%= new Date().getFullYear() %> RoqIA</span><span>Automação inteligente para o seu negócio</span></footer>
    </main>
  </body>
</html>
