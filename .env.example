PORT=3000
NODE_ENV=production

# URL interna do WPPConnect na rede Docker/EasyPanel. Não use barra no final.
WPPCONNECT_URL=http://automacoes_wppconnect:21465
WPPCONNECT_SECRET_KEY=

# Chave usada para assinar os cookies de sessão deste portal (mínimo recomendado: 32 caracteres).
ADMIN_SECRET=

# Caminho do arquivo de clientes dentro do container.
CLIENTS_FILE=config/clients.json
# Alternativa recomendada no EasyPanel: JSON completo em uma única variável.
# CLIENTS_JSON={"cliente1":{"name":"Cliente 1","session":"cliente1","pinHash":"scrypt$..."}}

# Sessão do cliente e proteção contra tentativas de PIN.
SESSION_TTL_MINUTES=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5

# Timeouts e ritmo de consulta do WPPConnect.
WPPCONNECT_TIMEOUT_MS=10000
WPPCONNECT_START_TIMEOUT_MS=35000
QR_POLL_ATTEMPTS=10
QR_POLL_INTERVAL_MS=1500
QR_START_COOLDOWN_MS=15000
